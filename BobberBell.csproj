<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\BobberBell.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BobberBell</RootNamespace>
    <AssemblyName>BobberBell</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>BobberBell</Product>
    <AssemblyTitle>BobberBell</AssemblyTitle>
    <Copyright>Copyright © 2026</Copyright>
    <Company></Company>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <!-- Release: no .pdb, no XML docs, no embedded build paths -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="packages\**" />
    <None Remove="packages\**" />
    <None Remove="FriendCodes.txt" />
    <None Remove="backup_pre_rename\**" />
    <Compile Remove="backup_pre_rename\**" />
    <None Remove="clouds.jpg" />
    <!-- Legacy .NET Framework files: not part of the .NET build -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Content Include="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BobberBell.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BobberBell_emblem_256.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\BobberBell_logo_blend.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.InputSimulator" Version="1.5.0" />
    <!-- NAudio: only Core, Wasapi (loopback capture, MediaFoundation) and WinMM (WaveOutEvent preview) are used. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- SoundFingerprinting.Audio.NAudio still declares the NAudio meta-package; ship none of its extra assemblies
         (NAudio.dll, Asio, Midi, WinForms). The app never touches the code paths that would need them. -->
    <PackageReference Include="NAudio" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.WinForms" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SoundFingerprinting" Version="17.4.0" />
    <PackageReference Include="SoundFingerprinting.Audio.NAudio" Version="8.0.0" />
  </ItemGroup>
</Project>
