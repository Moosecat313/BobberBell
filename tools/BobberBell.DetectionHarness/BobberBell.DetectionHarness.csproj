<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool: end-to-end check of the real detection core against live WASAPI loopback.
       Plays each reference splash (and non-splash controls) through an output device while capturing that device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416;CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BobberBell.Core\BobberBell.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.WinForms" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SoundFingerprinting" Version="17.4.0" />
    <PackageReference Include="SoundFingerprinting.Audio.NAudio" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\BobberBell\Sounds\*.wav" Link="Sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
